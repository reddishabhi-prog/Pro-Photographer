<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      NOTE: There is deliberately NO android.permission.INTERNET here.
      All intelligence runs on-device with bundled ML Kit models.
      Photos never leave the phone. This is a verifiable privacy guarantee:
      without the INTERNET permission the app physically cannot upload anything.
    -->

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Saving photos: legacy external storage only needed pre-Android 10. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Reading our own gallery of captured shots on Android 13+. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ML Kit pose-detection-common merges INTERNET and ACCESS_NETWORK_STATE in
         for its telemetry. Our models are bundled, so the network is never needed;
         strip both so the app physically cannot upload a photograph. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:name=".AIPhotographerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIPhotographer"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.ShotMuse.Starting"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
