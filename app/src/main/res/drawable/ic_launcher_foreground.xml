<?xml version="1.0" encoding="utf-8"?>
<!-- ShotMuse mark: a viewfinder (the camera) around a sparkle (the muse).
     Drawn inside the 66dp adaptive-icon safe zone so no launcher crops it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Viewfinder corners -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M31,43 L31,35 Q31,31 35,31 L43,31 M65,31 L73,31 Q77,31 77,35 L77,43 M77,65 L77,73 Q77,77 73,77 L65,77 M43,77 L35,77 Q31,77 31,73 L31,65">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31" android:startY="31"
                android:endX="77" android:endY="77"
                android:startColor="#FFD27A"
                android:endColor="#FF7A59" />
        </aapt:attr>
    </path>

    <!-- The muse: a four-point sparkle -->
    <path android:pathData="M54,38 C55.6,49.2 58.8,52.4 70,54 C58.8,55.6 55.6,58.8 54,70 C52.4,58.8 49.2,55.6 38,54 C49.2,52.4 52.4,49.2 54,38 Z">
