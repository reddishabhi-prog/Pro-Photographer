                android:startX="40" android:startY="40"
                android:endX="68" android:endY="68"
                android:startColor="#FFF4DA"
                android:endColor="#FFB547" />
        </aapt:attr>
    </path>

    <!-- A second, smaller spark -->
    <path
        android:fillColor="#FFE2A3"
        android:pathData="M67,37 C67.5,40.3 68.7,41.5 72,42 C68.7,42.5 67.5,43.7 67,47 C66.5,43.7 65.3,42.5 62,42 C65.3,41.5 66.5,40.3 67,37 Z" />
